# Copy to .env and fill in. The setup scripts generate this for you.
# chmod 600 .env -- it holds a provider key.

# --- which harness this process serves -----------------------------------------
# hermes-agent | pi  -> open-weight models on Ollama Cloud
# claude-code        -> Claude models (the documented exception)
DSPY_JEV_HARNESS=hermes-agent

# --- providers ------------------------------------------------------------------
# https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
# Only needed for DSPY_JEV_HARNESS=claude-code
ANTHROPIC_API_KEY=

# --- model selection (blank = registry default for the harness) -----------------
# Check availability first:  dspy-jev models --live
DSPY_JEV_DECISION_MODEL=
DSPY_JEV_FAST_MODEL=
DSPY_JEV_JUDGE_MODEL=

# --- inference -------------------------------------------------------------------
DSPY_JEV_TEMPERATURE=0.0
DSPY_JEV_MAX_TOKENS=2048
DSPY_JEV_NUM_RETRIES=3
DSPY_JEV_REQUEST_TIMEOUT_S=90
# ReAnchor needs the cache on to calibrate without re-billing every candidate.
DSPY_JEV_CACHE=true

# --- policy ----------------------------------------------------------------------
# Minimum P(safe_to_proceed) before an agent may act without review.
DSPY_JEV_AUTONOMY_THRESHOLD=0.85

# --- observability ----------------------------------------------------------------
DSPY_JEV_MLFLOW_ENABLED=true
DSPY_JEV_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
DSPY_JEV_MLFLOW_EXPERIMENT=dspy-jev
DSPY_JEV_OTEL_ENABLED=false
DSPY_JEV_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
DSPY_JEV_LOG_LEVEL=INFO
DSPY_JEV_LOG_FORMAT=json
# Logs full prompts and completions. Off by default: decisions carry user data.
DSPY_JEV_AUDIT_PAYLOADS=false

# --- service ----------------------------------------------------------------------
DSPY_JEV_SERVICE_HOST=127.0.0.1
DSPY_JEV_SERVICE_PORT=8080
# When set, /v1/* requires this value in the X-API-Key header.
DSPY_JEV_SERVICE_API_KEY=
